    <script>
        const searchInput = document.getElementById('searchInput');
        const venueView = document.getElementById('venueView');
        const genreView = document.getElementById('genreView');
        const venueContainer = document.getElementById('venueContainer');
        const genreContainer = document.getElementById('genreContainer');
        const venues = document.querySelectorAll('.venue');
        const bands = document.querySelectorAll('.band');

        // Genre classifications (simplified mock data)
        const bandGenres = {
            'Rock': ['Havrok', 'The Ferrett Forgits', 'Dead By Sunrise', 'Rage To Slitchez', 'Vote Evil'],
            'Folk': ['Morning Weather', 'Three Tea Emmy', 'Jason Ristiglus', 'Kevin Brown', 'Seth Connelly', 'Dan Blakeslee'],
            'Indie': ['Vibe Mo', 'A Bunch Of Jerks', 'Dibert', 'Congregation X', 'The Upstart Crows', 'Michael James'],
            'Electronic': ['Boogey And Overshed', 'Chrocks', 'Lava Sun', 'Dirty Frizzy', 'Halko'],
            'Jazz': ['JJ Swatt Jr', 'Reckless Culture', 'It Be Lovin', 'Eve Pierce', 'Mint Grinch'],
            'Acoustic': ['Emma Robinson', 'Crazy Nixon', 'Ian Shelby', 'Lyla Hutchins', 'Natalie Raccoon', 'Angela Semwell', 'Jess Hutchens', 'Maroon Massacals', 'Riley Walled'],
            'Alternative': ['Wandering of a Blackheart', 'Ashley Saint brand', 'Ryan Wells', 'Coochie Coochie', 'JD & The Stevenssons', 'HWDBS', 'Lowdowndale', 'Tenderhooks', 'Ringo', 'Alshel Underground', 'Brock Jackson', 'Shmy New Toys'],
            'Experimental': ['Olde Myths In The Raw', 'A Band By A Damson', 'The Snooze Allot', 'The Wagon', 'Dizam', 'Jaime Earthquake', 'Lesh Reynolds', 'Sunogram', 'Ba Da Ya Maniam', 'Dave Smisel', 'Cary Overbilt & Jennifer Hell', 'Magickal Heynotes']
        };

        function createGenreView() {
            genreContainer.innerHTML = '';
            Object.keys(bandGenres).forEach(genre => {
                const genreSection = document.createElement('div');
                genreSection.className = 'genre-section';
                genreSection.setAttribute('data-genre', genre);

                const genreHeader = document.createElement('div');
                genreHeader.className = 'genre-header';
                genreHeader.textContent = genre;
                genreSection.appendChild(genreHeader);

                const bandsDiv = document.createElement('div');
                bandsDiv.className = 'bands';

                bandGenres[genre].forEach(bandName => {
                    const bandElement = Array.from(bands).find(b =>
                        b.getAttribute('data-band') === bandName
                    );
                    if (bandElement) {
                        bandsDiv.appendChild(bandElement.cloneNode(true));
                    }
                });

                genreSection.appendChild(bandsDiv);
                genreContainer.appendChild(genreSection);
            });
        }

        createGenreView();

        venueView.addEventListener('click', () => {
            venueView.classList.add('active');
            genreView.classList.remove('active');
            venueContainer.classList.remove('hidden');
            genreContainer.classList.add('hidden');
        });

        genreView.addEventListener('click', () => {
            genreView.classList.add('active');
            venueView.classList.remove('active');
            venueContainer.classList.add('hidden');
            genreContainer.classList.remove('hidden');
        });

        searchInput.addEventListener('input', function(e) {
            const searchTerm = e.target.value.toLowerCase().trim();
            const isVenueView = !venueContainer.classList.contains('hidden');

            if (searchTerm === '') {
                if (isVenueView) {
                    venues.forEach(venue => venue.classList.remove('hidden'));
                    bands.forEach(band => band.classList.remove('hidden'));
                } else {
                    document.querySelectorAll('.genre-section').forEach(section =>
                        section.classList.remove('hidden')
                    );
                    document.querySelectorAll('#genreContainer .band').forEach(band =>
                        band.classList.remove('hidden')
                    );
                }
                return;
            }

            if (isVenueView) {
                bands.forEach(band => {
                    const bandName = band.getAttribute('data-band').toLowerCase();
                    if (bandName.includes(searchTerm)) {
                        band.classList.remove('hidden');
                    } else {
                        band.classList.add('hidden');
                    }
                });

                venues.forEach(venue => {
                    const visibleBands = venue.querySelectorAll('.band:not(.hidden)');
                    if (visibleBands.length === 0) {
                        venue.classList.add('hidden');
                    } else {
                        venue.classList.remove('hidden');
                    }
                });
            } else {
                document.querySelectorAll('#genreContainer .band').forEach(band => {
                    const bandName = band.getAttribute('data-band').toLowerCase();
                    if (bandName.includes(searchTerm)) {
                        band.classList.remove('hidden');
                    } else {
                        band.classList.add('hidden');
                    }
                });

                document.querySelectorAll('.genre-section').forEach(section => {
                    const visibleBands = section.querySelectorAll('.band:not(.hidden)');
                    if (visibleBands.length === 0) {
                        section.classList.add('hidden');
                    } else {
                        section.classList.remove('hidden');
                    }
                });
            }
        });
    </script>
</body>
</html>